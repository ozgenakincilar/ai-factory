<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <!-- 10.0.13 patches GHSA-334f-vvp4-7g6p (CVE-2026-70159) in Microsoft.AspNetCore.SignalR.Common <= 10.0.12. -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Factory.Core\Factory.Core.csproj" />
    <ProjectReference Include="..\..\src\Factory.Orchestration\Factory.Orchestration.csproj" />
    <ProjectReference Include="..\..\src\Factory.Infrastructure\Factory.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Factory.Api\Factory.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\evidence\analyst-live-*.json" Link="Evidence\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\docs\evidence\architect-live-*.json" Link="Evidence\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\docs\evidence\workflow-live-*.json" Link="Evidence\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
